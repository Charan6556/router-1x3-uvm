# scripts/synth_sky130.sh stages the caller's Liberty file in build/sky130/.
read_verilog -Irtl rtl/router_top.v

hierarchy -check -top router_top

proc
opt

fsm
opt

memory
opt

techmap
opt

dfflibmap -liberty build/sky130/sky130.lib

abc -liberty build/sky130/sky130.lib

clean

stat -liberty build/sky130/sky130.lib

write_verilog -noattr build/sky130/router_sky130_netlist.v
clean

stat -liberty build/sky130/sky130.lib

flatten
opt
clean

stat -liberty build/sky130/sky130.lib

# Preserve the archived netlist in synthesis/ when repeating the flow.
write_verilog -noattr build/sky130/router_sky130_netlist.v

